@startuml
left to right direction
actor "Responsable des Apprenants" as Admin
actor Apprenant

rectangle Gérer-les-Sanctions {
  usecase "Définir les Règles de Sanction" as UC1
  usecase "Calculer et Appliquer les Sanctions" as UC2
  usecase "Suivi des sanctions" as UC9
  usecase "Recevoir une notification de sanction" as UC3
  usecase "Consulter l'Historique des Sanctions" as UC4
  usecase "Gestion des Sanctions" as UC5
  usecase "Rechercher et filtrer les Sanctions" as UC7
  usecase "Consulter les Statistiques" as UC8
}

Admin -- UC1
Admin -- UC5
Admin -- UC8

Apprenant -- UC3
Apprenant -- UC4

UC5 ..> UC2 : <<include>>
UC5 ..> UC7 : <<include>>
UC5 ..> UC9 : <<include>>
